{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "~/Software/zig/0.16/zig build -Doptimize=Debug -Denable_llvm=true",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "build valgrind",
            "type": "shell",
            "command": "~/Software/zig/0.16/zig build -Dcpu=x86_64 -Doptimize=Debug -Denable_llvm=true",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "build-test",
            "type": "shell",
            "command": "~/Software/zig/0.16/zig test -Denable_llvm=true --test-no-exec -femit-bin=zig-out/bin/${fileBasenameNoExtension}-test ${file}",
        },
        {
            "label": "build-test-all",
            "type": "shell",
            "command": "~/Software/zig/0.16/zig build -Dcpu=x86_64 -Doptimize=Debug -Dtest_category=cpu -Dtest_filter=+",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },

        // Profiling
		{
			"type": "process",
			"label": "CPU Profiling (callgrind)",
			"command": "valgrind",
			"args": [
				"--tool=callgrind",
                "--dump-instr=yes",
                "--collect-jumps=yes",
				"--callgrind-out-file=zig-out/callgrind.out",
				"${workspaceFolder}/zig-out/bin/zig-gb",
                "playground/link_awake.gb",
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "none",
			"detail": "CPU Profile program by using callgrind"
		},
		{
			"type": "process",
			"label": "Cache Profiling (cachgrind)",
			"command": "valgrind",
			"args": [
				"--tool=cachegrind",
                "--cache-sim=yes",
                "--branch-sim=yes",
				"--cachegrind-out-file=zig-out/cachegrind.out",
				"${workspaceFolder}/zig-out/bin/zig-gb",
                "playground/link_awake.gb",
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "none",
			"detail": "Cache Profile program by using cachegrind"
		},
		{
			"type": "process",
			"label": "Memory Profiling (massif)",
			"command": "valgrind",
			"args": [
				"--tool=massif",
                "--stacks=yes",
                "--heap=no",
                "--threshold=0.1",
				"--massif-out-file=zig-out/massif.out",
				"${workspaceFolder}/zig-out/bin/zig-gb",
                "playground/link_awake.gb",
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "none",
			"detail": "Memory Profile program by using massif"
		},
		{
			"type": "process",
			"label": "Memory Leak Checking (memcheck)",
			"command": "valgrind",
			"args": [
				"--tool=memcheck",
				"--leak-check=full",
				"--show-leak-kinds=all",
				"${workspaceFolder}/zig-out/bin/zig-gb",
                "playground/link_awake.gb",
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "none",
			"detail": "Memory error check program by using memcheck"
		},
		{
			"type": "process",
			"label": "Open CPU profile data (kcachegrind)",
			"command": "kcachegrind",
			"args": [
				"zig-out/callgrind.out"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "none",
			"detail": "Open CPU profile data using kcachegrind"
		},
		{
			"type": "process",
			"label": "Open cache profile data (kcachegrind)",
			"command": "kcachegrind",
			"args": [
				"zig-out/cachegrind.out"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "none",
			"detail": "Open cache profile data using kcachegrind"
		},
		{
			"type": "process",
			"label": "Open memory profile data (massif-visualizer)",
			"command": "massif-visualizer",
			"args": [
				"zig-out/massif.out"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "none",
			"detail": "Open memory profile data using massif-visualizer"
		},
    ]
}